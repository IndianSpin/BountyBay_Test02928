{
  "name": "@bounty-bay/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "tsx scripts/safe-reset.ts"
  },
  "dependencies": {
    "@bounty-bay/config": "workspace:*",
    "@bounty-bay/domain": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@bounty-bay/ai": "workspace:*",
    "@bounty-bay/intelligence": "workspace:*"
  },
  "devDependencies": {
    "dotenv": "^17.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.0"
  }
}
