# Names only — never commit real values (10_SECURITY_INTEGRITY.md, SI secrets policy).

# PostgreSQL (docker compose dev defaults shown; host port 5433 to avoid the local Supabase stack)
DATABASE_URL=postgresql://bounty:bounty@localhost:5433/bounty_bay

# Redis (docker compose dev default shown)
REDIS_URL=redis://localhost:6379

# Clerk (M3): auth provider keys are injected by the deployment manager
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_PUBLIC_KEY=
# Web-facing publishable key (Next.js client bundle)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Base URL of the API for client fetches
NEXT_PUBLIC_API_URL=http://localhost:4000

# Dev-only auth (apps/api): signing secret for dev tokens — never set in production
DEV_AUTH_SECRET=

# API
API_PORT=4000
